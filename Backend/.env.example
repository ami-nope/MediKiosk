# =============================================================================
# MediKiosk Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your setup.

# --- Database ---
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./medikiosk.db
# PostgreSQL (swap when ready):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/medikiosk

# --- LLM Provider ---
# Options: "openai" | "anthropic" | "gemini" | "openrouter" | "omnirouter" | "ollama"
LLM_PROVIDER=gemini

# --- OpenAI-compatible provider ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- OpenRouter / OmniRouter-compatible provider ---
OPENROUTER_API_KEY=sk-your-openrouter-or-omnirouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.7-flash
# Cheaper option: gemini-3.5-flash-lite

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- File uploads ---
UPLOAD_DIR=./uploads

# --- CORS ---
# Comma-separated list of allowed origins (kiosk tablets + doctor dashboard)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.1.0/24
